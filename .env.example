# Copy to .env (or set in your host's dashboard). Only TOKEN_SECRET and STRIPE_SECRET_KEY matter in production.
PORT=3000
# Public base URL; Stripe redirects back here after checkout. Required in production.
PUBLIC_URL=https://badchoices.example.com
# Signs unlock codes. Generate with: openssl rand -hex 32. Changing it invalidates every purchase.
TOKEN_SECRET=
# sk_test_... for testing, sk_live_... for real money.
STRIPE_SECRET_KEY=
CURRENCY=usd
# Where stats.json (and a generated token secret, if TOKEN_SECRET is unset) are stored.
DATA_DIR=./.data
# Set to 1 behind a reverse proxy so rate limiting uses X-Forwarded-For.
TRUST_PROXY=0
# Local testing only: purchases succeed without payment. Ignored when a live Stripe key is set.
DEV_UNLOCK=0
